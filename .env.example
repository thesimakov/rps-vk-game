DATABASE_URL="file:./dev.db"

# ID мини-приложения ВК (vk.com/apps?act=manage)
NEXT_PUBLIC_VK_APP_ID="1234567"

# Базовый путь, если приложение развёрнуто не в корне домена (для VK Hosting обычно пусто)
# NEXT_PUBLIC_BASE_PATH="/rps"

# Если фронт на GitHub Pages (статика), а API крутится на VPS с полноценным Next — укажи origin бэкенда.
# Иначе fetch на /api/presence, /api/match, /api/player не сработают (на Pages нет сервера).
# Пример: NEXT_PUBLIC_API_BASE_URL="https://play.lemnity.ru"
# NEXT_PUBLIC_API_BASE_URL="https://play.lemnity.ru"

# Только на VPS (сервер): CORS для запросов с другого origin (Pages, VK). См. middleware.ts
# CORS_ALLOWED_ORIGINS=https://YOU.github.io,https://web.vk.com,https://vk.com,https://m.vk.com,https://*.github.io

# ID группы ВК для бонуса за подписку (опционально)
# NEXT_PUBLIC_VK_GROUP_ID="123456789"

# Секретные ключи приложения ВК для серверной подписи платежей
# Хранить только на сервере, никогда не на клиенте.
VK_APP_SECRET_KEY="ЗАМЕНИ_НА_СЕКРЕТ_ИЗ_НАСТРОЕК_ВК"
VK_SERVICE_KEY="ЗАМЕНИ_НА_SERVICE_KEY_ЕСЛИ_НУЖЕН"

# Включить полноценный серверный режим (API-роуты Next.js, без статического экспорта)
# При деплое на свой сервер установи: NEXT_OUTPUT_EXPORT=0
NEXT_OUTPUT_EXPORT="0"

# Опционально: SQLite с очередью матчмейкинга + heartbeat онлайн (по умолчанию рядом с PLAYERS_DB_PATH)
# GAME_STATE_DB_PATH="/var/rps-data/game-state.sqlite"

