DATABASE_URL="file:./dev.db"

# ID мини-приложения ВК (vk.com/apps?act=manage)
NEXT_PUBLIC_VK_APP_ID="1234567"

# Базовый путь, если приложение развёрнуто не в корне домена (для VK Hosting обычно пусто)
# NEXT_PUBLIC_BASE_PATH="/rps"

# Если фронт — статика (Pages/CDN), а API на другом домене — задай при СБОРКЕ фронта (без слэша в конце):
# NEXT_PUBLIC_API_BASE_URL="https://api.example.com"
# Подробно: docs/DEPLOY_VK_API.md

# На VPS, если фронт с другого origin (ВК, GitHub Pages): разреши CORS
# CORS_ALLOWED_ORIGINS=https://web.vk.com,https://vk.com,https://m.vk.com,https://YOUR.github.io,https://*.github.io

# ID группы ВК для бонуса за подписку (опционально)
# NEXT_PUBLIC_VK_GROUP_ID="123456789"

# Опционально: ссылка «Отправить ошибку» после включения уведомлений (иначе откроется чат с группой по ID выше)
# NEXT_PUBLIC_BUG_REPORT_URL="https://docs.google.com/forms/..."

# Ключ типа игрового запроса для VKWebAppShowRequestBox (настройки приложения ВК → игровые запросы). По умолчанию 1.
# NEXT_PUBLIC_VK_GAME_INVITE_REQUEST_KEY=1

# Секретные ключи приложения ВК для серверной подписи платежей
# Хранить только на сервере, никогда не на клиенте.
VK_APP_SECRET_KEY="ЗАМЕНИ_НА_СЕКРЕТ_ИЗ_НАСТРОЕК_ВК"
VK_SERVICE_KEY="ЗАМЕНИ_НА_SERVICE_KEY_ЕСЛИ_НУЖЕН"

# Опционально: URL для всплывающей рекламы вне ВК (каждый 3-й переход к выбору ставки: кнопка «Играть» внизу / «Играть онлайн» и т.д.). Во ВК — нативный interstitial.
# NEXT_PUBLIC_PLAY_AD_WEB_URL="https://example.com/ad-page"

# Баннер ВК: top | bottom (по умолчанию bottom). Реклама за вознаграждение: монет после просмотра reward-ролика.
# NEXT_PUBLIC_VK_BANNER_LOCATION=bottom
# NEXT_PUBLIC_VK_REWARD_AD_COINS=50

# Включить полноценный серверный режим (API-роуты Next.js, без статического экспорта)
# При деплое на свой сервер установи: NEXT_OUTPUT_EXPORT=0
NEXT_OUTPUT_EXPORT="0"

# Опционально: SQLite с очередью матчмейкинга + heartbeat онлайн (по умолчанию рядом с PLAYERS_DB_PATH)
# GAME_STATE_DB_PATH="/var/rps-data/game-state.sqlite"

# Временно на VPS при отладке: curl /api/health/sqlite покажет текст ошибки SQLite (потом удалить)
# ALLOW_SQLITE_DIAGNOSTIC=1

