DATABASE_URL="file:./dev.db"

# VK Mini Apps
NEXT_PUBLIC_VK_APP_ID="ВАШ_APP_ID"
NEXT_PUBLIC_VK_REDIRECT_URI="https://play.lemnity.ru/"

# Важно: включаем серверный режим Next.js (API-роуты работают)
NEXT_OUTPUT_EXPORT="0"

# Секреты ВК (только на сервере)
VK_APP_SECRET_KEY="ВАШ_VK_APP_SECRET_KEY"
VK_SERVICE_KEY="ВАШ_VK_SERVICE_KEY"

# CORS: если фронт на GitHub Pages / VK, а API на этом домене — перечисли origin страницы (через запятую).
# Пример: CORS_ALLOWED_ORIGINS=https://USER.github.io,https://web.vk.com,https://vk.com,https://m.vk.com,https://*.github.io
# CORS_ALLOWED_ORIGINS=""

# Опционально
# NEXT_PUBLIC_VK_GROUP_ID="123456789"
# NEXT_PUBLIC_BASE_PATH=""
